# Backend only. Production values are applied to the Vercel API project.
# Use Supabase's transaction pooler (port 6543) for Vercel Functions.
DATABASE_URL=postgresql://kaki_app.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=3
API_BRIDGE_KEY=shared-random-secret-with-next-server
AUTH_INVITE_CODE=private-organiser-invite
PORT=5030
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5-mini
OPENAI_SUGGESTIONS_MODEL=gpt-4.1-nano
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
