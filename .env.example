# Server-only restricted PostgreSQL login. TLS certificate verification is required.
DATABASE_URL=postgresql://kaki_app:password@your-server.postgres.database.azure.com:5432/kaki
DATABASE_POOL_MAX=3
# Set to the exact deployed origin on Vercel. Use localhost only for development.
APP_ORIGIN=http://localhost:5026
# Required for permanent pilot account registration; never NEXT_PUBLIC_.
AUTH_INVITE_CODE=replace-with-a-random-organiser-invite
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5-mini
OPENAI_SUGGESTIONS_MODEL=gpt-4.1-nano
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
